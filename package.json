    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@pandacss/dev": "^2.5.0",
    "@pandacss/preset-base": "^2.5.0",
    "@pandacss/preset-panda": "^2.5.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lefthook": "^2.2.2",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
